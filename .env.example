# VMS Stage 1 configuration. Copy to .env and fill in. Never commit .env.
#
# Generate the two key values with:
#   python manage.py generate_key       (or: openssl rand -base64 32)

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
# 50+ random chars. Rotating this invalidates all sessions (but NOT encrypted data).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Comma-separated. The base domain is enough: every church signs in there, and which
# church you land in is decided by the address you sign in with. The leading-dot
# wildcard is only needed if you give individual churches hostnames of their own.
#
# Keep `localhost` in the list: the container's own health check probes
# http://localhost:8000/healthz/ from inside the compose network, and Django rejects a
# hostname that is not listed here before any view runs.
ALLOWED_HOSTS=vms.example.ca,.vms.example.ca,localhost

# Comma-separated, scheme required. The app sits behind Nginx Proxy Manager, which
# terminates SSL, so these are https:// even though the container speaks http. One
# entry per hostname that submits forms — normally just the base domain.
CSRF_TRUSTED_ORIGINS=https://vms.example.ca

# The address every church signs in at. Used to build church URLs and to derive the
# WebAuthn Relying Party ID.
VMS_BASE_DOMAIN=vms.example.ca

# Port published on the host for Nginx Proxy Manager to point at.
VMS_HTTP_PORT=8020

# ---------------------------------------------------------------------------
# Sign-in links
#
# There are no passwords. A single-use emailed link covers the two moments a passkey
# does not exist yet: first sign-in, and recovery after losing one.
# ---------------------------------------------------------------------------

# How long a link lives. An invite may sit unread over a weekend; a recovery link is
# being used now, so a short window limits what a forwarded email is worth.
VMS_INVITE_LINK_DAYS=7
VMS_RECOVERY_LINK_MINUTES=30

# Recovery requests allowed per address, and per source IP. Each one that lands sends
# real mail to a real person.
VMS_RECOVERY_RATELIMIT=3/1h

# Passkey sign-in attempts allowed per source IP.
LOGIN_RATELIMIT=30/5m

# Scheme and host for the links we email. Separate from VMS_BASE_DOMAIN because that
# one doubles as a hostname in the tenant registry and so cannot carry a port. Leave
# unset unless you are running on a non-standard port.
# VMS_LINK_SCHEME=https
# VMS_LINK_HOST=vms.example.ca

# ---------------------------------------------------------------------------
# Encryption — READ THIS
# ---------------------------------------------------------------------------
# Wraps every per-tenant data-encryption key (DEK). LOSING THIS MAKES ALL TENANT
# DATA UNRECOVERABLE except from the individually escrowed DEKs. Back it up in
# Keeper Security before going live. 32 bytes, base64-encoded.
PLATFORM_MASTER_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL (matches the db service in docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Hour (0-23, server local time) the nightly compliance recompute + digest runs.
VMS_NIGHTLY_HOUR=2
TZ=America/Vancouver

# ---------------------------------------------------------------------------
# Email — Azure Communication Services, Canada geography
# ---------------------------------------------------------------------------
# smtp: live ACS relay. console: print to stdout (dev/test). Anything else is rejected.
EMAIL_PROVIDER=console
EMAIL_HOST=smtp.azurecomm.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
# ACS SMTP username is: <acs-resource-name>.<entra-app-id>.<entra-tenant-id>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@vms.example.ca
# Where unexpected-error mail goes.
SERVER_EMAIL=no-reply@vms.example.ca

# ---------------------------------------------------------------------------
# Documents
# ---------------------------------------------------------------------------
# Per-upload ceiling in megabytes.
VMS_MAX_UPLOAD_MB=20
